    "@types/pdfkit": "^0.17.6",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.0",
    "exceljs": "^4.4.0",
    "geist": "^1.5.1",
    "lucide-react": "^0.358.0",
    "next": "16.4.5",
    "papaparse": "^5.5.3",
    "pdfkit": "^0.18.0",
    "react": "^18",
    "react-dom": "^18",
    "resend": "^6.11.0",
    "serwist": "^9.5.7",
    "stripe": "^14.0.0",
    "tailwind-merge": "^2.2.1",
    "web-push": "^3.6.7",
    "xlsx": "file:vendor/xlsx-0.20.3.tgz",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/web-push": "^3.6.4",
    "autoprefixer": "^10.0.1",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.4.5",
    "postcss": "^8",
    "prisma": "^5.10.2",
    "tailwindcss": "^3.3.0",
    "ts-node": "^10.9.2",
    "typescript": "^5",
    "vitest": "^2.1.9"
  },
